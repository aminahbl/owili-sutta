---
import SuttaFooter from "~/components/SuttaFooter.astro";
import Layout from "~/layouts/Layout.astro";
import { getRandomSutta } from "~/scripts";

// Shown without JavaScript. With it, the script loads a random sutta into the empty page.
const { id, translator } = getRandomSutta();
---

<Layout title="Oh wow, the digital fairies handpicked a sutta for me!">
  <div data-content>
    <noscript>
      <p><a href={`/${id}/?translator=${translator}`}>Read a sutta: {id}</a></p>
    </noscript>
  </div>
  <noscript slot="footer">
    <SuttaFooter id={id} translators={[translator]} />
  </noscript>
</Layout>

<script src="../scripts/initialize.ts"></script>
<script src="../scripts/handlers.ts"></script>
