---
import { Languages, Share2 } from "@lucide/astro";
---

<nav>
   <div class="group">
    <button
      class="icon"
      data-btn="view"
      title="Change view"
      aria-label="Change view"
      aria-keyshortcuts="V C"
      data-click="View button"
    >
      <Languages aria-hidden="true" size={22} stroke-width={1.75} />
    </button>
    <button
      class="icon"
      id="share-link-btn"
      data-btn="share"
      title="Share this sutta"
      aria-label="Copy link and share this sutta"
      data-click="Share sutta button"
    >
      <Share2 aria-hidden="true" size={22} stroke-width={1.75} />
    </button>
  </div>

  <div class="group chips">
    <button
      class="chip"
      data-btn="short"
      title="Get another short sutta"
      data-click="Short sutta button"
    >
      Get short
    </button>
    <button
      class="chip"
      data-btn="long"
      title="Get a longer sutta"
      data-click="Long sutta button"
    >
      Get long
    </button>
  </div>
 
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    margin: 0.75rem 0.5rem 3rem;
  }

  button {
    background: transparent;
    color: rgba(var(--clr-text-dark), 0.7);
    font: inherit;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;

    &:hover {
      color: rgb(var(--clr-accent-dark));
      background-color: rgba(var(--clr-accent-dark), 0.07);
    }

    &:focus-visible {
      outline: 2px solid rgb(var(--clr-accent));
      outline-offset: 2px;
    }
  }

  .group {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .group.chips {
    gap: 0.5rem;
  }

  .chip {
    padding: 0.25rem 0.75rem;
    border: 1px solid rgba(var(--clr-text-dark), 0.3);
    border-radius: 999px;
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;

    &:hover {
      border-color: rgba(var(--clr-accent-dark), 0.7);
    }
  }

  .icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: rgba(var(--clr-text-dark), 0.05);
  }

  .divider {
    width: 1px;
    height: 1.4rem;
    margin-inline-start: 0.65rem;
    background: linear-gradient(
      transparent,
      rgba(var(--clr-text-dark), 0.35),
      transparent
    );
  }

  .tip::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    width: max-content;
    padding: 0.2rem 0.6rem;
    border-radius: 0.5rem;
    background-color: rgb(var(--clr-surface));
    box-shadow: 0 0.25rem 1rem rgba(var(--clr-text-dark), 0.12);
    color: rgb(var(--clr-text-dark));
    font-size: 0.75rem;
    animation: appear 0.2s ease-out;
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  @media (max-width: 359px) {
    nav {
      gap: 0.25rem;
    }

    .chip {
      font-size: 0.65rem;
      letter-spacing: 0;
    }
  }

  @media (min-width: 560px) {
    nav {
      margin-inline: auto;
    }
  }
</style>
