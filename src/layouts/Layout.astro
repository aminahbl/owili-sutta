---
import LoadingOverlay from "~/components/LoadingOverlay.astro";
import SuttaFooter from "~/components/SuttaFooter.astro";
import TopTools from "~/components/TopTools.astro";

interface Props {
  title: string;
  path?: string;
  loading?: boolean;
  sutta?: { id: string; translator: string };
}

const { title, path, loading = false, sutta } = Astro.props;
const description =
  "Basking in the compassion of the Buddha and his wise followers";
const siteUrl = "https://sutta.ohwowiloveit.com/";
const pageUrl = path ? siteUrl + path : siteUrl;
const imageUrl = "https://ik.imagekit.io/tvm15igl7/socials/sutta.png";
const siteName = "OhWowASutta!";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="image" content={imageUrl} />
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:alt" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image:alt" content={siteName} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="article" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <TopTools />
    <main>
      <LoadingOverlay visible={loading} />

      <slot />
    </main>
    {sutta && <SuttaFooter {...sutta} />}

    <style is:global>
      :root {
        --clr-bg: 242, 239, 234;
        --clr-surface: 250, 249, 246;
        --clr-text-dark: 44, 44, 44;
        --clr-accent: 85, 113, 86;
        --clr-accent-dark: 49, 10, 101;
      }

      html {
        font-family: system-ui, sans-serif;
        background: rgb(var(--clr-bg));
        background-size: 224px;
        color: rgb(var(--clr-text-dark));
        font-size: 20px;
        line-height: 1.6;
      }

      main {
        margin-block: auto;
        margin-inline: 0.5rem;
        padding-block: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
      }

      ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
      }

      h1 {
        position: relative;
        padding-bottom: 1.5rem;
        margin-top: 1rem;
        font-size: 2.7rem;
        line-height: 3.2rem;
      }

      h1::after {
        content: "";
        position: absolute;
        bottom: 0.5rem;
        left: 0;
        right: 0;
        border-bottom: 1px dotted rgba(var(--clr-text-dark), 0.7);
      }

      a {
        color: rgb(var(--clr-accent));
      }

      @media (min-width: 560px) {
        main {
          margin: auto;
        }
      }
    </style>
  </body>
</html>
