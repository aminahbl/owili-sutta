---
import TopTools from "~/components/TopTools.astro";
import translatorNames from "../../data/translators.json";

interface Props {
  title: string;
  path?: string;
  sutta?: { id: string; root: string; translators: string[] };
}

const { title, path = "", sutta } = Astro.props;
const description =
  "Basking in the compassion of the Buddha and his wise followers";
const siteUrl = "https://randhamma.ohwowiloveit.com/";
const pageUrl = siteUrl + path;
// CSS cannot compare two attributes, so each translator gets a rule that hides the other translations.
const translatorRules = Object.keys(translatorNames)
  .map(
    (translator) =>
      `html[data-translator="${translator}"] [data-translator]:not([data-translator="${translator}"]) { display: none; }`
  )
  .join("\n");
const imageUrl = "https://ik.imagekit.io/tvm15igl7/socials/sutta.png";
const siteName = "OhWowASutta!";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="image" content={imageUrl} />
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={imageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image:alt" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image:alt" content={siteName} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="article" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {
      sutta && (
        <script is:inline define:vars={sutta}>
          const params = new URLSearchParams(location.search);
          const requested = params.get("translator");
          const translator = translators.includes(requested)
            ? requested
            : translators[0];
          let view = "source";
          if (requested) view = params.has("source") ? "both" : "translation";
          document.documentElement.dataset.view = view;
          document.documentElement.dataset.translator = translator;

          const canonical = document.createElement("link");
          canonical.rel = "canonical";
          canonical.href =
            view === "source"
              ? `https://suttacentral.net/${id}/${root}`
              : `https://suttacentral.net/${id}/en/${translator}`;
          document.head.append(canonical);
        </script>
      )
    }
    <style is:inline set:html={translatorRules}></style>
  </head>
  <body>
    <TopTools />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <style is:global>
      :root {
        --clr-bg: 242, 239, 234;
        --clr-surface: 250, 249, 246;
        --clr-text-dark: 44, 44, 44;
        --clr-accent: 85, 113, 86;
        --clr-accent-dark: 117, 69, 119;
      }

      html {
        font-family: system-ui, sans-serif;
        background: rgb(var(--clr-bg));
        background-size: 224px;
        color: rgb(var(--clr-text-dark));
        font-size: 20px;
        line-height: 1.6;
      }

      main {
        margin-block: auto;
        margin-inline: 0.5rem;
        padding-block: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
      }

      /* Keeps the footer below the fold when the content is short. */
      main:has(+ footer) {
        min-height: 100vh;
      }

      ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
      }

      h1 {
        position: relative;
        padding-bottom: 1.5rem;
        margin-top: 0.5rem;
        font-size: 2.2rem;
        line-height: 2.6rem;
      }

      h1::after {
        content: "";
        position: absolute;
        bottom: 0.5rem;
        left: 0;
        right: 0;
        border-bottom: 1px dotted rgba(var(--clr-text-dark), 0.7);
      }

      a {
        color: rgb(var(--clr-accent));
      }

      html[data-view="translation"] .root,
      html[data-view="source"] [data-translator] {
        display: none;
      }

      /* With both shown, and without JavaScript, the source and translation alternate line by line.
         :where() keeps these rules weaker than the ones that hide the other translations. */
      html:where([data-view="both"], :not([data-view])) [data-content] {
        & :where(.root, .translation) {
          display: block;
        }

        & .root {
          color: rgba(var(--clr-text-dark), 0.7);
          margin-top: 0.5rem;
        }
      }

      @media (min-width: 560px) {
        main {
          margin: auto;
        }
      }
    </style>
  </body>
</html>
